{
  "name": "lead-intelligence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "pipeline": "bun run src/pipeline/run.ts",
    "analysis:propensity": "python3 analysis/train_propensity.py",
    "analysis:priority": "bun run scripts/score-distribution.ts",
    "analysis:assignment": "bun run scripts/assignment-analysis.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "csv-parse": "^6.1.0",
    "next": "^16.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "prisma": "^6.16.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
