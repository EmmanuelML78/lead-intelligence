# ---------------------------------------------------------------------------
# Required for dashboard runtime AND pipeline
# ---------------------------------------------------------------------------
# Managed Postgres (Neon or equivalent). Never commit a real URL.
# Runtime (Vercel): pooled connection is fine.
# Migrations (`bun run db:migrate:deploy`): use a direct (non-pooled) URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ---------------------------------------------------------------------------
# Required for a stable assessment demo (dashboard + assignment)
# ---------------------------------------------------------------------------
# Synthetic sources are historical relative to wall-clock execution.
# Pinning this America/Bogota calendar date keeps capacity and assignment
# snapshots stable during evaluation. Do not omit it on the public demo.
BUSINESS_TIMEZONE="America/Bogota"
ASSIGNMENT_BUSINESS_DATE="2026-09-14"

# ---------------------------------------------------------------------------
# Pipeline-only: AI conversation extraction (Gemini)
# ---------------------------------------------------------------------------
# Dashboard runtime does NOT call Gemini. Do not put AI_API_KEY on Vercel
# unless you intentionally run the pipeline in that environment.
# Empty AI_API_KEY is supported: ingestion/scoring/assignment still run;
# the AI stage reports SKIPPED.
AI_PROVIDER="gemini"
AI_API_KEY=""
# Optional. Defaults to gemini-3.6-flash (see src/lib/ai/providers/gemini.ts).
AI_MODEL=""
# Optional. Max concurrent provider requests (default 4).
AI_CONCURRENCY="4"
# Optional. Cap how many eligible conversations to send to the provider
# in this run (cache hits still count). Unset = process all eligible.
# Use 5 for a live smoke batch before the full extraction.
AI_MAX_CONVERSATIONS=""

# ---------------------------------------------------------------------------
# Pipeline-only orchestration (optional)
# ---------------------------------------------------------------------------
# Set to 1/true to skip a later stage. Used to ingest first, then AI, then
# score, then assign on a brand-new database (see README). Defaults off.
PIPELINE_SKIP_SCORING=""
PIPELINE_SKIP_ASSIGNMENT=""
