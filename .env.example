DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# AI conversation extraction (Milestone 3). Only Gemini is implemented
# (src/lib/ai/providers/gemini.ts) -- see docs/architecture.md.
# Leaving AI_API_KEY empty is supported: the pipeline still runs end to
# end, the AI extraction stage just reports SKIPPED instead of failing.
AI_PROVIDER="gemini"
AI_API_KEY=""
# Optional: defaults to gemini-3.6-flash if unset (see src/lib/ai/providers/gemini.ts).
AI_MODEL=""
# Optional: max concurrent provider requests during the AI stage (default 4).
AI_CONCURRENCY="4"

# Assignment engine (Milestone 6). Business dates are America/Bogota
# calendar dates stored as UTC midnight (date-only). Set
# ASSIGNMENT_BUSINESS_DATE=YYYY-MM-DD for deterministic runs/tests.
# Wall-clock "today" is used only when that variable is unset.
BUSINESS_TIMEZONE="America/Bogota"
ASSIGNMENT_BUSINESS_DATE=""

PIPELINE_SECRET="replace-me"
