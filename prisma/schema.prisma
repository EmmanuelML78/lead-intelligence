generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LeadChannel {
  WHATSAPP
  META_ADS
  WEB_FORM
  UNKNOWN
}

enum LeadStatus {
  SIN_GESTION
  CONTACTADO
  NO_CONTESTA
  COTIZACION_ENVIADA
  EN_PROCESO
  DESCARTADO
  UNKNOWN
}

enum PipelineRunStatus {
  RUNNING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
}

enum Temperature {
  VERY_HOT
  HOT
  WARM
  LOW
}

model Company {
  id          String       @id
  name        String?
  salesPoints SalesPoint[]
  advisors    Advisor[]
  customers   Customer[]
  leads       Lead[]
}

model SalesPoint {
  id        String    @id
  companyId String
  company   Company   @relation(fields: [companyId], references: [id])
  advisors  Advisor[]
  leads     Lead[]

  @@index([companyId])
}

model Advisor {
  id            String     @id
  name          String
  companyId     String
  salesPointId  String
  dailyCapacity Int
  active        Boolean
  joinedAt      DateTime?
  company       Company    @relation(fields: [companyId], references: [id])
  salesPoint    SalesPoint @relation(fields: [salesPointId], references: [id])
  assignments   Assignment[]

  @@index([companyId, salesPointId, active])
}

model Customer {
  id              String   @id @default(cuid())
  companyId       String
  normalizedName  String?
  normalizedPhone String?
  normalizedEmail String?
  city             String?
  company          Company  @relation(fields: [companyId], references: [id])
  leads            Lead[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([companyId, normalizedPhone])
  @@index([companyId, normalizedEmail])
}

model Lead {
  id                 String      @id
  companyId          String
  salesPointId       String
  customerId         String?
  registeredAt       DateTime?
  channel            LeadChannel
  customerNameRaw    String?
  phoneRaw           String?
  emailRaw           String?
  cityRaw            String?
  motorcycleTextRaw  String?
  status             LeadStatus
  firstContactAt     DateTime?
  campaign           String?
  sourceFingerprint  String
  rawPayload         Json
  company            Company     @relation(fields: [companyId], references: [id])
  salesPoint         SalesPoint  @relation(fields: [salesPointId], references: [id])
  customer           Customer?   @relation(fields: [customerId], references: [id])
  conversations      Conversation[]
  aiExtractions      AiExtraction[]
  scores             LeadScore[]
  assignments        Assignment[]
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([companyId, salesPointId, status])
  @@index([registeredAt])
}

model Conversation {
  id          String    @id
  leadId      String?
  sourceLeadId String
  channel     String?
  startedAt   DateTime?
  isOrphan    Boolean   @default(false)
  lead        Lead?     @relation(fields: [leadId], references: [id])
  messages    Message[]
  createdAt   DateTime  @default(now())

  @@index([leadId])
  @@index([isOrphan])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  sender         String
  sentTime       String?
  text           String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model Motorcycle {
  sku         String                @id
  brand       String
  line        String
  displacement Int
  segment     String
  listPrice   Int
  inventory   MotorcycleInventory[]
}

model MotorcycleInventory {
  id           String     @id @default(cuid())
  motorcycleSku String
  salesPointId String
  available    Boolean    @default(true)
  unitsGlobal  Int
  motorcycle   Motorcycle @relation(fields: [motorcycleSku], references: [sku], onDelete: Cascade)

  @@unique([motorcycleSku, salesPointId])
  @@index([salesPointId, available])
}

model AiExtraction {
  id                   String   @id @default(cuid())
  leadId               String
  motorcycleInterest   String?
  budget               Int?
  downPayment          Int?
  paymentMethod        String?
  purchaseIntent       String?
  mainObjection        String?
  requestedAppointment Boolean  @default(false)
  requestedQuote       Boolean  @default(false)
  confidence           Float?
  evidence             Json?
  provider             String?
  model                 String?
  promptVersion         String
  lead                  Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdAt             DateTime @default(now())

  @@index([leadId, createdAt])
}

model LeadScore {
  id              String      @id @default(cuid())
  leadId          String
  propensity      Float
  intent          Float
  urgency         Float
  inventoryBonus  Float
  totalScore      Float
  temperature     Temperature
  explanation     Json
  modelVersion    String
  lead             Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdAt        DateTime     @default(now())

  @@index([leadId, createdAt])
  @@index([totalScore])
}

model Assignment {
  id         String   @id @default(cuid())
  leadId     String
  advisorId  String
  assignedFor DateTime
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  advisor    Advisor  @relation(fields: [advisorId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([leadId, assignedFor])
  @@index([advisorId, assignedFor])
}

model PipelineRun {
  id              String            @id @default(cuid())
  status          PipelineRunStatus
  startedAt       DateTime          @default(now())
  finishedAt      DateTime?
  received        Int               @default(0)
  processed       Int               @default(0)
  duplicates      Int               @default(0)
  orphanConversations Int           @default(0)
  warnings        Int               @default(0)
  errors          Int               @default(0)
  metadata        Json?
  issues          PipelineIssue[]
}

model PipelineIssue {
  id            String      @id @default(cuid())
  pipelineRunId String
  type          String
  severity      String
  entityType    String?
  entityId      String?
  rawValue      String?
  message       String
  pipelineRun   PipelineRun @relation(fields: [pipelineRunId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@index([pipelineRunId, severity])
}
